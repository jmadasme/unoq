[111.988, "o", "\u001b[90m┌─ unoq_gpio_control.ino · READ / WRITE / ANALOG / PWM ─────────────────────────────────────────────────\u001b[0m\n"]
[111.988, "o", "\u001b[90m 434\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m// ─── ejecutarRead() ───────────────────────────────────────────────\u001b[39;49;00m\n"]
[112.043, "o", "\u001b[90m 435\u001b[0m\u001b[90m │ \u001b[0m\u001b[96mvoid\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mejecutarRead\u001b[39;49;00m(\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mpin)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[112.098, "o", "\u001b[90m 436\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mstate\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mdigitalRead(pin);\u001b[90m\u001b[39;49;00m\n"]
[112.153, "o", "\u001b[90m 437\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mresponder(\u001b[33m\"\u001b[39;49;00m\u001b[33mOK \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m \u001b[39;49;00m+\u001b[90m \u001b[39;49;00mString(state));\u001b[90m\u001b[39;49;00m\n"]
[112.208, "o", "\u001b[90m 438\u001b[0m\u001b[90m │ \u001b[0m}\u001b[90m\u001b[39;49;00m\n"]
[112.263, "o", "\u001b[90m 439\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[112.318, "o", "\u001b[90m 440\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m// ─── ejecutarWrite() ──────────────────────────────────────────────\u001b[39;49;00m\n"]
[112.373, "o", "\u001b[90m 441\u001b[0m\u001b[90m │ \u001b[0m\u001b[96mvoid\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mejecutarWrite\u001b[39;49;00m(\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mpin,\u001b[90m \u001b[39;49;00m\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mvalor)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[112.428, "o", "\u001b[90m 442\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// Configurar el pin como OUTPUT antes de escribir\u001b[39;49;00m\n"]
[112.483, "o", "\u001b[90m 443\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// (si ya era OUTPUT, pinMode no hace daño repetirlo)\u001b[39;49;00m\n"]
[112.538, "o", "\u001b[90m 444\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mpinMode(pin,\u001b[90m \u001b[39;49;00mOUTPUT);\u001b[90m\u001b[39;49;00m\n"]
[112.593, "o", "\u001b[90m 445\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mdigitalWrite(pin,\u001b[90m \u001b[39;49;00mvalor);\u001b[90m\u001b[39;49;00m\n"]
[112.648, "o", "\u001b[90m 446\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[112.703, "o", "\u001b[90m 447\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mstate\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mdigitalRead(pin);\u001b[90m    \u001b[39;49;00m\u001b[90m// Leer de vuelta para confirmar\u001b[39;49;00m\n"]
[112.758, "o", "\u001b[90m 448\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mresponder(\u001b[33m\"\u001b[39;49;00m\u001b[33mOK \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m \u001b[39;49;00m+\u001b[90m \u001b[39;49;00mString(state));\u001b[90m\u001b[39;49;00m\n"]
