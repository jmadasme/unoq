[95.66, "o", "\u001b[90m┌─ unoq_gpio_control.ino · parsearPin() ────────────────────────────────────────────────────────────────\u001b[0m\n"]
[95.66, "o", "\u001b[90m 401\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m// ─── parsearPin() ─────────────────────────────────────────────────\u001b[39;49;00m\n"]
[95.715, "o", "\u001b[90m 402\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m// Soporta notación numérica (0-19) y con prefijo A (A0-A5 → 14-19)\u001b[39;49;00m\n"]
[95.77, "o", "\u001b[90m 403\u001b[0m\u001b[90m │ \u001b[0m\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mparsearPin\u001b[39;49;00m(\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00mString\u001b[90m \u001b[39;49;00m&token)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[95.825, "o", "\u001b[90m 404\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mString\u001b[90m \u001b[39;49;00mt\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mtoken;\u001b[90m\u001b[39;49;00m\n"]
[95.88, "o", "\u001b[90m 405\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mt.trim();\u001b[90m\u001b[39;49;00m\n"]
[95.935, "o", "\u001b[90m 406\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[95.99, "o", "\u001b[90m 407\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(t.length()\u001b[90m \u001b[39;49;00m==\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[96.045, "o", "\u001b[90m 408\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mreturn\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[94m-1\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
[96.1, "o", "\u001b[90m 409\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
[96.155, "o", "\u001b[90m 410\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[96.21, "o", "\u001b[90m 411\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m// ¿Comienza con 'A' o 'a'?\u001b[39;49;00m\n"]
[96.265, "o", "\u001b[90m 412\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(t.charAt(\u001b[94m0\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m==\u001b[90m \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mA\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[90m \u001b[39;49;00m||\u001b[90m \u001b[39;49;00mt.charAt(\u001b[94m0\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m==\u001b[90m \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33ma\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[96.32, "o", "\u001b[90m 413\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mString\u001b[90m \u001b[39;49;00mnumStr\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mt.substring(\u001b[94m1\u001b[39;49;00m);\u001b[90m\u001b[39;49;00m\n"]
[96.375, "o", "\u001b[90m 414\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[96.43, "o", "\u001b[90m 415\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m// Verificar que hay un dígito después de 'A' (ej. \"A\" solo → inválido)\u001b[39;49;00m\n"]
[96.485, "o", "\u001b[90m 416\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(numStr.length()\u001b[90m \u001b[39;49;00m==\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[96.54, "o", "\u001b[90m 417\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m\u001b[94mreturn\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[94m-1\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
[96.595, "o", "\u001b[90m 418\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
[96.65, "o", "\u001b[90m 419\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[96.705, "o", "\u001b[90m 420\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00manalogIndex\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mnumStr.toInt();\u001b[90m\u001b[39;49;00m\n"]
[96.76, "o", "\u001b[90m 421\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[96.815, "o", "\u001b[90m 422\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m// Solo A0–A5 están disponibles\u001b[39;49;00m\n"]
[96.87, "o", "\u001b[90m 423\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(analogIndex\u001b[90m \u001b[39;49;00m>=\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m\u001b[90m \u001b[39;49;00m&&\u001b[90m \u001b[39;49;00manalogIndex\u001b[90m \u001b[39;49;00m<=\u001b[90m \u001b[39;49;00m\u001b[94m5\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[96.925, "o", "\u001b[90m 424\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m\u001b[94mreturn\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[94m14\u001b[39;49;00m\u001b[90m \u001b[39;49;00m+\u001b[90m \u001b[39;49;00manalogIndex;\u001b[90m     \u001b[39;49;00m\u001b[90m// A0=14, A1=15, ..., A5=19\u001b[39;49;00m\n"]
[96.98, "o", "\u001b[90m 425\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
[97.035, "o", "\u001b[90m 426\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m// A6, A7, etc. → inválido\u001b[39;49;00m\n"]
[97.09, "o", "\u001b[90m 427\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mreturn\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[94m-1\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
