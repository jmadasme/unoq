[27.964, "o", "\u001b[90m   3\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m \u001b[39;49;00mPlaca:\u001b[90m \u001b[39;49;00mArduino\u001b[90m \u001b[39;49;00mUNO\u001b[90m \u001b[39;49;00mQ\u001b[90m \u001b[39;49;00m(STM32U585,\u001b[90m \u001b[39;49;00mZephyr\u001b[90m \u001b[39;49;00mRTOS)\u001b[90m\u001b[39;49;00m\n"]
[28.019, "o", "\u001b[90m   4\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m \u001b[39;49;00mFQBN:\u001b[90m \u001b[39;49;00marduino:zephyr:unoq\u001b[90m\u001b[39;49;00m\n"]
[28.074, "o", "\u001b[90m   5\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m \u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.129, "o", "\u001b[90m   6\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m \u001b[39;49;00mProtocolo\u001b[90m \u001b[39;49;00mSerial\u001b[90m \u001b[39;49;00ma\u001b[90m \u001b[39;49;00m\u001b[94m115200\u001b[39;49;00m\u001b[90m \u001b[39;49;00mbaud:\u001b[90m\u001b[39;49;00m\n"]
[28.184, "o", "\u001b[90m   7\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m   \u001b[39;49;00mREAD\u001b[90m \u001b[39;49;00m<pin>\u001b[90m          \u001b[39;49;00m\u001b[04m\u001b[91m→\u001b[39;49;00m\u001b[90m \u001b[39;49;00mlee\u001b[90m \u001b[39;49;00mestado\u001b[90m \u001b[39;49;00mdigital\u001b[90m \u001b[39;49;00mdel\u001b[90m \u001b[39;49;00mpin\u001b[90m   \u001b[39;49;00m\u001b[04m\u001b[91m→\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mOK 0\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m \u001b[39;49;00mo\u001b[90m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mOK 1\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.239, "o", "\u001b[90m   8\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m   \u001b[39;49;00mWRITE\u001b[90m \u001b[39;49;00m<pin>\u001b[90m \u001b[39;49;00m<\u001b[94m0\u001b[39;49;00m|\u001b[94m1\u001b[39;49;00m>\u001b[90m   \u001b[39;49;00m\u001b[04m\u001b[91m→\u001b[39;49;00m\u001b[90m \u001b[39;49;00mescribe\u001b[90m \u001b[39;49;00mestado\u001b[90m \u001b[39;49;00mdigital\u001b[90m        \u001b[39;49;00m\u001b[04m\u001b[91m→\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mOK 0\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m \u001b[39;49;00mo\u001b[90m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mOK 1\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.294, "o", "\u001b[90m   9\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m \u001b[39;49;00m*\u001b[90m   \u001b[39;49;00mANALOG\u001b[90m \u001b[39;49;00m<pin>\u001b[90m        \u001b[39;49;00m\u001b[04m\u001b[91m→\u001b[39;49;00m\u001b[90m \u001b[39;49;00mlee\u001b[90m \u001b[39;49;00mADC\u001b[90m \u001b[39;49;00m\u001b[94m12\u001b[39;49;00m-bit\u001b[90m \u001b[39;49;00m(\u001b[94m0\u001b[39;49;00m\u001b[94m-4095\u001b[39;49;00m)\u001b[90m       \u001b[39;49;00m\u001b[04m\u001b[91m→\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mOK <valor>\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
