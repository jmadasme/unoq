[45.361, "o", "\u001b[90m 155\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mpinMode(p,\u001b[90m \u001b[39;49;00mINPUT);\u001b[90m\u001b[39;49;00m\n"]
