[97.31, "o", "\u001b[90m 431\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mreturn\u001b[39;49;00m\u001b[90m \u001b[39;49;00mt.toInt();\u001b[90m\u001b[39;49;00m\n"]
[97.365, "o", "\u001b[90m 432\u001b[0m\u001b[90m │ \u001b[0m}\u001b[90m\u001b[39;49;00m\n"]
